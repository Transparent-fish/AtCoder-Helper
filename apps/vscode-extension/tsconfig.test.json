{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2020",
    "outDir": "out-test",
    "rootDir": "src",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": ["src/**/*.test.ts"]
}
