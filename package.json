{
  "name": "vscode-boilerplate",
  "displayName": "VS Code Boilerplate",
  "version": "0.1.0",
  "private": true,
  "description": "Modern VS Code extension template with Turbo, TypeScript, WebView, React, and Tailwind",
  "packageManager": "pnpm@8.10.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev --filter=atc-helper...",
    "lint": "turbo lint",
    "clean": "turbo clean",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "test": "turbo test",
    "watch": "turbo watch --filter=atc-helper..."
  },
  "devDependencies": {
    "@cs-magic/md-toc": "^0.5.2",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^8.54.0",
    "postcss-loader": "^8.1.1",
    "prettier": "^3.1.0",
    "turbo": "^2.9.14",
    "typescript": "^5.3.2",
    "vite": "^5.0.0"
  }
}
